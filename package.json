{
  "name": "openfc-web",
  "version": "1.1.0",
  "private": true,
  "description": "OpenFC Web Platform — browser-based firmware flasher and field controller for the OpenFC VEX V5 field controller board",
  "scripts": {
    "dev": "npm run generate:api && next dev",
    "generate:api": "node scripts/generate-api.mjs",
    "build": "npm run generate:api && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "esptool-js": "^0.5.7",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/w3c-web-serial": "^1.0.6",
    "autoprefixer": "^10.4.19",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  }
}
